# Copy this file to .env and fill in your own values.
#   cp .env.sample .env
#
# .env is gitignored and must never be committed. This file is the tracked
# template: keep the field names in sync, never put a real value here.

# Required only for --backend claude and for image OCR.
# The rules backend runs fully offline without it.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5 when unset.
ANTHROPIC_MODEL=

# Optional. Whisper size for voice-note transcription: tiny|base|small|medium.
# Defaults to base when unset.
WHISPER_MODEL=
